# Copy this file to .env and fill in real values before running the server.
# .env itself should NEVER be committed to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB:   mongodb://127.0.0.1:27017/smartpos
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartpos
MONGODB_URI=mongodb://127.0.0.1:27017/smartpos
mongodb+srv://Drey:Lv6pXZzcR3vgnBYn@brigz18.lhji0.mongodb.net/?appName=Brigz18

# --- Auth ---
# Use a long, random, secret string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of origins allowed to call this API. Leave blank
# during local development if you're opening the frontend via file:// or
# through this same server (see server.js: it serves the frontend directly
# from http://localhost:5000, which needs no CORS entry at all).
# Example for a separately-hosted frontend:
# CLIENT_ORIGIN=https://your-frontend-domain.com
CLIENT_ORIGIN=
