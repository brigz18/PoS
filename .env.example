# ==========================================
# SmartPOS Backend - Environment Variables
# Copy this file to .env and adjust as needed.
# ==========================================

PORT=5000
NODE_ENV=development

# --- Local MongoDB (MongoDB Community Server running on your machine) ---
# This matches "mongodb://localhost:27017" - Mongoose will create the
# "smartpos" database automatically the first time data is written.
MONGO_URI=mongodb://127.0.0.1:27017/smartpos

# --- OR MongoDB Atlas (cloud) - use this instead if you prefer the cloud ---
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartpos?retryWrites=true&w=majority

JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# List every origin your frontend might be opened from.
# http://localhost:5000        -> if the backend itself serves the frontend
# http://127.0.0.1:5500 / 5500 -> VS Code "Live Server" extension default port
# http://localhost:3000        -> common alternative static server port
CLIENT_ORIGIN=http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
