# Copy this file to .env and fill in real values before running the server.
# .env itself should NEVER be committed to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB:   mongodb://127.0.0.1:27017/smartpos
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartpos
# --- Database ---
MONGODB_URI=mongodb+srv://Drey:Lv6pXZzcR3vgnBYn@brigz18.lhji0.mongodb.net/smartpos?appName=Brigz18

# --- Auth ---
# REQUIRED, and checked at startup (server.js refuses to boot without a real
# one): at least 32 random characters, and NOT the placeholder text below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=4a35a8f32e8863c12330447d87f4762e2e1904780bbdf8b2692671b69f5ab959
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of origins allowed to make cross-origin browser
# requests to this API. Leave blank during local development (the frontend
# served by this same server, or opened via a separate dev server on
# another port, both still work - see server.js). In production
# (NODE_ENV=production), an empty value here means NO cross-origin browser
# requests are allowed at all - only set this if your frontend is hosted on
# a different origin than this API.
# Example: CLIENT_ORIGIN=https://your-frontend-domain.com
CLIENT_ORIGIN=
