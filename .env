# ==========================================
# SmartPOS Backend - Local Development Environment
# Using local MongoDB Community Server (mongodb://localhost:27017)
# ==========================================

PORT=5000
NODE_ENV=development

# Local MongoDB 8.2.1 Community instance - "smartpos" is the database name,
# Mongoose will create it automatically the first time data is written.
MONGO_URI=mongodb://127.0.0.1:27017/smartpos

# JWT
JWT_SECRET=smartpos_local_dev_secret_change_this_in_production_5f8a9c2e1b
JWT_EXPIRES_IN=7d

# CORS - list every origin your frontend might be opened from.
# http://localhost:5000       -> if you let the backend serve the frontend itself
# http://127.0.0.1:5500 / 5500 -> VS Code "Live Server" extension default port
# http://localhost:3000        -> common alternative static server port
# Requests with NO Origin header at all (curl, Postman, file:// pages) are
# always allowed by server.js regardless of this list.
CLIENT_ORIGIN=http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
